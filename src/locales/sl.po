#: src/lib/i18n/lingui.test.ts
msgid "{count, plural, one {# entry} other {# entries}}"
msgstr "{count, plural, one {# vnos} two {# vnosa} few {# vnosi} other {# vnosov}}"

#: src/entrypoints/options/main.ts
#: src/lib/i18n/lingui.test.ts
msgid "Server address"
msgstr "Naslov strežnika"

#: src/entrypoints/background.ts
msgid "Hrček: sign in again"
msgstr "Hrček: prijavite se znova"

#: src/entrypoints/background.ts
msgid "Hrček"
msgstr "Hrček"

#: src/entrypoints/background.ts
msgid "Waiting to sync ({count})…"
msgstr "Čaka na sinhronizacijo ({count})…"

#: src/entrypoints/background.ts
#: src/entrypoints/pending/view.ts
msgid "Sync now"
msgstr "Sinhroniziraj zdaj"

#: src/entrypoints/popup/chips.ts
msgid "Add a tag"
msgstr "Dodaj oznako"

#: src/entrypoints/popup/chips.ts
msgid "Remove {tag}"
msgstr "Odstrani {tag}"

#: src/entrypoints/options/main.ts
#: src/entrypoints/popup/main.ts
msgid "Could not reach {server}."
msgstr "Strežnika {server} ni bilo mogoče doseči."

#: src/entrypoints/popup/main.ts
msgid "The picture could not be attached."
msgstr "Slike ni bilo mogoče priložiti."

#: src/entrypoints/popup/main.ts
msgid "Hrček can't be reached. Saving keeps this entry here until it can."
msgstr "Hrček ni dosegljiv. Ob shranjevanju vnos ostane tukaj, dokler ne bo."

#: src/entrypoints/popup/main.ts
msgid "Waiting to be saved to Hrček."
msgstr "Čaka, da se shrani na Hrček."

#: src/entrypoints/popup/main.ts
msgid "Hrček refused this entry: {reason}"
msgstr "Hrček je ta vnos zavrnil: {reason}"

#: src/entrypoints/popup/main.ts
msgid "You also have an unsynced copy of this page — saving here replaces it."
msgstr "Imate tudi nesinhronizirano kopijo te strani — shranjevanje tukaj jo nadomesti."

#: src/entrypoints/popup/main.ts
msgid "100 entries are already waiting to be saved. Sync or delete some first."
msgstr "Na shranjevanje že čaka 100 vnosov. Najprej jih sinhronizirajte ali nekaj izbrišite."

#: src/entrypoints/options/main.ts
#: src/entrypoints/pending/view.ts
#: src/entrypoints/popup/main.ts
msgid "Something went wrong."
msgstr "Nekaj je šlo narobe."

#: src/entrypoints/popup/main.ts
msgid "Kept for later — it will be saved to Hrček once it can be reached."
msgstr "Shranjeno za pozneje — na Hrček bo shranjeno, ko bo dosegljiv."

#: src/entrypoints/popup/main.ts
msgid "{option} (no longer offered)"
msgstr "{option} (ni več na voljo)"

#: src/entrypoints/popup/main.ts
msgid "Your fields"
msgstr "Vaša polja"

#: src/entrypoints/pending/view.ts
#: src/entrypoints/popup/main.ts
msgid "Hrček is not configured yet."
msgstr "Hrček še ni nastavljen."

#: src/entrypoints/popup/main.ts
msgid "Open settings"
msgstr "Odpri nastavitve"

#: src/entrypoints/pending/view.ts
#: src/entrypoints/popup/main.ts
msgid "Your Hrček no longer accepts this token. Make a new one in settings."
msgstr "Vaš Hrček tega žetona ne sprejema več. Ustvarite novega v nastavitvah."

#: src/entrypoints/popup/main.ts
msgid "Already saved"
msgstr "Že shranjeno"

#: src/entrypoints/popup/main.ts
msgid "Title"
msgstr "Naslov"

#: src/entrypoints/popup/main.ts
msgid "Notes"
msgstr "Zapiski"

#: src/entrypoints/popup/main.ts
msgid "Picture"
msgstr "Slika"

#: src/entrypoints/popup/main.ts
msgid "Tags"
msgstr "Oznake"

#: src/entrypoints/popup/main.ts
msgid "Your fields could not be loaded — saving will not change them."
msgstr "Vaših polj ni bilo mogoče naložiti — shranjevanje jih ne bo spremenilo."

#: src/entrypoints/popup/main.ts
msgid "Update"
msgstr "Posodobi"

#: src/entrypoints/options/main.ts
#: src/entrypoints/popup/main.ts
msgid "Save"
msgstr "Shrani"

#: src/entrypoints/popup/main.ts
msgid "Settings not available."
msgstr "Nastavitve niso na voljo."

#: src/entrypoints/options/main.ts
#: src/entrypoints/popup/main.ts
msgid "Saving…"
msgstr "Shranjujem…"

#: src/entrypoints/popup/main.ts
msgid "This address is already saved. Review the existing entry, then save again."
msgstr "Ta naslov je že shranjen. Preglejte obstoječi vnos in shranite znova."

#: src/entrypoints/popup/main.ts
msgid "Saving the picture…"
msgstr "Shranjujem sliko…"

#: src/entrypoints/popup/main.ts
msgid "Saved, but the picture could not be attached: {reason}"
msgstr "Shranjeno, slike pa ni bilo mogoče priložiti: {reason}"

#: src/entrypoints/options/main.ts
#: src/entrypoints/popup/main.ts
msgid "Saved."
msgstr "Shranjeno."

#: src/entrypoints/popup/main.ts
msgid "Updated."
msgstr "Posodobljeno."

#: src/entrypoints/popup/main.ts
msgid "Save for later"
msgstr "Shrani za pozneje"

#: src/entrypoints/popup/picture-overlay.ts
msgid "Choose a picture"
msgstr "Izberi sliko"

#: src/entrypoints/popup/picture-overlay.ts
msgid "Use this picture"
msgstr "Uporabi to sliko"

#: src/entrypoints/popup/picture-overlay.ts
msgid "Selected"
msgstr "Izbrano"

#: src/entrypoints/popup/picture-overlay.ts
msgid "Earlier pictures"
msgstr "Prejšnje slike"

#: src/entrypoints/popup/picture-overlay.ts
msgid "More pictures"
msgstr "Več slik"

#: src/entrypoints/popup/picture-overlay.ts
#: src/entrypoints/popup/picture-row.ts
msgid "It has a picture that cannot be shown here"
msgstr "Ima sliko, ki je tu ni mogoče pokazati"

#: src/entrypoints/popup/picture-overlay.ts
msgid "The picture it has"
msgstr "Slika, ki jo ima"

#: src/entrypoints/popup/picture-overlay.ts
msgid "Picture {number} of {total}"
msgstr "Slika {number} od {total}"

#: src/entrypoints/popup/picture-overlay.ts
msgid "current"
msgstr "trenutna"

#: src/entrypoints/popup/picture-overlay.ts
msgid "Close"
msgstr "Zapri"

#: src/entrypoints/popup/picture-row.ts
msgid "Include picture"
msgstr "Vključi sliko"

#: src/entrypoints/popup/picture-row.ts
msgid "Change"
msgstr "Zamenjaj"

#: src/entrypoints/pending/view.ts
msgid "Waiting to sync"
msgstr "Čaka na sinhronizacijo"

#: src/entrypoints/pending/view.ts
msgid "Hrček can't be reached."
msgstr "Hrček ni dosegljiv."

#: src/entrypoints/pending/view.ts
msgid "{count, plural, one {# entry saved.} other {# entries saved.}}"
msgstr "{count, plural, one {# vnos shranjen.} two {# vnosa shranjena.} few {# vnosi shranjeni.} other {# vnosov shranjenih.}}"

#: src/entrypoints/pending/view.ts
msgid "Saved without its picture: {title}"
msgstr "Shranjeno brez slike: {title}"

#: src/entrypoints/pending/view.ts
msgid "{count, plural, one {# is already on Hrček and waits for your review.} other {# are already on Hrček and wait for your review.}}"
msgstr "{count, plural, one {# je že na Hrčku in čaka na vaš pregled.} two {# sta že na Hrčku in čakata na vaš pregled.} few {# so že na Hrčku in čakajo na vaš pregled.} other {# jih je že na Hrčku in čakajo na vaš pregled.}}"

#: src/entrypoints/pending/view.ts
msgid "Delete"
msgstr "Izbriši"

#: src/entrypoints/pending/view.ts
msgid "Delete for good"
msgstr "Izbriši dokončno"

#: src/entrypoints/pending/view.ts
msgid "Cancel"
msgstr "Prekliči"

#: src/entrypoints/pending/view.ts
msgid "Open page"
msgstr "Odpri stran"

#: src/entrypoints/pending/view.ts
msgid "Loading what Hrček has…"
msgstr "Nalagam, kar ima Hrček…"

#: src/entrypoints/pending/view.ts
msgid "Keep what's on Hrček"
msgstr "Obdrži, kar je na Hrčku"

#: src/entrypoints/pending/view.ts
msgid "Replace with mine"
msgstr "Zamenjaj z mojim"

#: src/entrypoints/pending/view.ts
msgid "Hrček no longer has this address."
msgstr "Hrček tega naslova nima več."

#: src/entrypoints/pending/view.ts
msgid "On Hrček"
msgstr "Na Hrčku"

#: src/entrypoints/pending/view.ts
msgid "Yours"
msgstr "Vaše"

#: src/entrypoints/pending/view.ts
msgid "Hrček can't be reached, so what it has can't be shown."
msgstr "Hrček ni dosegljiv, zato ni mogoče pokazati, kar ima."

#: src/entrypoints/pending/view.ts
msgid "Saved {when}"
msgstr "Shranjeno {when}"

#: src/entrypoints/pending/view.ts
msgid "Saved for {server}, which is not the one in your settings."
msgstr "Shranjeno za {server}, ki ni strežnik v vaših nastavitvah."

#: src/entrypoints/pending/view.ts
msgid "Hrček refused it: {reason}"
msgstr "Hrček ga je zavrnil: {reason}"

#: src/entrypoints/pending/view.ts
msgid "Nothing is waiting."
msgstr "Nič ne čaka."

#: src/entrypoints/options/main.ts
msgid "Automatic ({language})"
msgstr "Samodejno ({language})"

#: src/entrypoints/options/main.ts
msgid "Settings"
msgstr "Nastavitve"

#: src/entrypoints/options/main.ts
msgid "API token"
msgstr "Žeton API"

#: src/entrypoints/options/main.ts
msgid "Language"
msgstr "Jezik"

#: src/entrypoints/options/main.ts
msgid "Show whether a page is already saved"
msgstr "Pokaži, ali je stran že shranjena"

#: src/entrypoints/options/main.ts
msgid "The toolbar ticks the hamster on pages you have saved. Doing so asks your Hrček about every address you visit. Turn it off and the toolbar only says whether the extension is configured."
msgstr "Orodna vrstica označi hrčka na straneh, ki ste jih shranili. Za to vaš Hrček vpraša za vsak naslov, ki ga obiščete. Če to izklopite, orodna vrstica pove le, ali je razširitev nastavljena."

#: src/entrypoints/options/main.ts
msgid "Paste one from "
msgstr "Prilepite ga s "

#: src/entrypoints/options/main.ts
msgid "your clients page"
msgstr "strani vaših odjemalcev"

#: src/entrypoints/options/main.ts
msgid ", or let Hrček make one below."
msgstr ", ali pa naj ga Hrček ustvari spodaj."

#: src/entrypoints/options/main.ts
msgid "Test connection"
msgstr "Preveri povezavo"

#: src/entrypoints/options/main.ts
msgid "Create a token with your password"
msgstr "Ustvari žeton z geslom"

#: src/entrypoints/options/main.ts
msgid "Your password is used once to ask Hrček for a token, and is never stored. The token appears above and is what the extension uses from then on."
msgstr "Vaše geslo se enkrat uporabi, da Hrčka prosi za žeton, in se nikoli ne shrani. Žeton se pokaže zgoraj in razširitev odslej uporablja samo njega."

#: src/entrypoints/options/main.ts
msgid "Email or display name"
msgstr "E-pošta ali prikazno ime"

#: src/entrypoints/options/main.ts
msgid "Password"
msgstr "Geslo"

#: src/entrypoints/options/main.ts
msgid "Create token"
msgstr "Ustvari žeton"

#: src/entrypoints/options/main.ts
msgid "Too many attempts. Wait a while before trying again, or paste a token from your clients page."
msgstr "Preveč poskusov. Počakajte nekaj časa in poskusite znova ali prilepite žeton s strani odjemalcev."

#: src/entrypoints/options/main.ts
msgid "This Hrček cannot make tokens for an extension. Create one on your clients page and paste it above."
msgstr "Ta Hrček ne zna ustvariti žetonov za razširitev. Ustvarite ga na strani odjemalcev in ga prilepite zgoraj."

#: src/entrypoints/options/main.ts
msgid "Saved. Site access was declined — press Save again to grant it."
msgstr "Shranjeno. Dostop do strani je bil zavrnjen — znova pritisnite Shrani, da ga dovolite."

#: src/entrypoints/options/main.ts
msgid "Asking Hrček for a token…"
msgstr "Prosim Hrčka za žeton…"

#: src/entrypoints/options/main.ts
msgid "Saved. Token created as \"{name}\"."
msgstr "Shranjeno. Žeton je ustvarjen kot »{name}«."

#: src/entrypoints/options/main.ts
msgid "Save a server address and token first."
msgstr "Najprej shranite naslov strežnika in žeton."

#: src/entrypoints/options/main.ts
msgid "Testing…"
msgstr "Preverjam…"

#: src/entrypoints/options/main.ts
msgid "Connected as {email}."
msgstr "Povezani kot {email}."
