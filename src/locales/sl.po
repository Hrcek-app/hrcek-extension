#: src/entrypoints/options/main.ts
msgid "Settings"
msgstr "Nastavitve"

#: src/entrypoints/options/main.ts
msgid "Server address"
msgstr "Naslov strežnika"

#: src/entrypoints/options/main.ts
msgid "API token"
msgstr "Žeton API"

#: src/entrypoints/options/main.ts
msgid "Language"
msgstr "Jezik"

#: src/entrypoints/options/main.ts
msgid "Automatic ({language})"
msgstr "Samodejno ({language})"

#: src/entrypoints/options/main.ts
msgid "Show whether a page is already saved"
msgstr "Pokaži, ali je stran že shranjena"

#: src/entrypoints/options/main.ts
msgid ""
"The toolbar ticks the hamster on pages you have saved. Doing so asks your "
"Hrček about every address you visit. Turn it off and the toolbar only says "
"whether the extension is configured."
msgstr ""
"Orodna vrstica označi hrčka na straneh, ki ste jih shranili. Za to vaš "
"Hrček vpraša za vsak naslov, ki ga obiščete. Če to izklopite, orodna "
"vrstica pove le, ali je razširitev nastavljena."

#: src/entrypoints/options/main.ts
msgid "Paste one from "
msgstr "Prilepite ga s "

#: src/entrypoints/options/main.ts
msgid "your clients page"
msgstr "strani vaših odjemalcev"

#: src/entrypoints/options/main.ts
msgid ", or let Hrček make one below."
msgstr ", ali pa naj ga Hrček ustvari spodaj."

#: src/entrypoints/options/main.ts
msgid "Save"
msgstr "Shrani"

#: src/entrypoints/options/main.ts
msgid "Test connection"
msgstr "Preveri povezavo"

#: src/entrypoints/options/main.ts
msgid "Create a token with your password"
msgstr "Ustvari žeton z geslom"

#: src/entrypoints/options/main.ts
msgid ""
"Your password is used once to ask Hrček for a token, and is never stored. "
"The token appears above and is what the extension uses from then on."
msgstr ""
"Vaše geslo se enkrat uporabi, da Hrčka prosi za žeton, in se nikoli ne "
"shrani. Žeton se pokaže zgoraj in razširitev odslej uporablja samo njega."

#: src/entrypoints/options/main.ts
msgid "Email or display name"
msgstr "E-pošta ali prikazno ime"

#: src/entrypoints/options/main.ts
msgid "Password"
msgstr "Geslo"

#: src/entrypoints/options/main.ts
msgid "Create token"
msgstr "Ustvari žeton"

#: src/entrypoints/options/main.ts
msgid "Saving…"
msgstr "Shranjujem…"

#: src/entrypoints/options/main.ts
msgid "Saved."
msgstr "Shranjeno."

#: src/entrypoints/options/main.ts
msgid "Saved. Site access was declined — press Save again to grant it."
msgstr ""
"Shranjeno. Dostop do strani je bil zavrnjen — znova pritisnite Shrani, da "
"ga dovolite."

#: src/entrypoints/options/main.ts
msgid "Asking Hrček for a token…"
msgstr "Prosim Hrčka za žeton…"

#: src/entrypoints/options/main.ts
msgid "Saved. Token created as \"{name}\"."
msgstr "Shranjeno. Žeton je ustvarjen kot »{name}«."

#: src/entrypoints/options/main.ts
msgid "Save a server address and token first."
msgstr "Najprej shranite naslov strežnika in žeton."

#: src/entrypoints/options/main.ts
msgid "Testing…"
msgstr "Preverjam…"

#: src/entrypoints/options/main.ts
msgid "Connected as {email}."
msgstr "Povezani kot {email}."

#: src/entrypoints/options/main.ts
msgid ""
"Too many attempts. Wait a while before trying again, or paste a token from "
"your clients page."
msgstr ""
"Preveč poskusov. Počakajte nekaj časa in poskusite znova ali prilepite "
"žeton s strani odjemalcev."

#: src/entrypoints/options/main.ts
msgid ""
"This Hrček cannot make tokens for an extension. Create one on your clients "
"page and paste it above."
msgstr ""
"Ta Hrček ne zna ustvariti žetonov za razširitev. Ustvarite ga na strani "
"odjemalcev in ga prilepite zgoraj."

#: src/entrypoints/options/main.ts
msgid "Something went wrong."
msgstr "Nekaj je šlo narobe."

#. Four forms where English has two. This is what our own catalogue cannot
#. express: 1 vnos, 2 vnosa, 3 vnosi, 5 vnosov.
#: src/lib/i18n/lingui.test.ts
msgid "{count, plural, one {# entry} other {# entries}}"
msgstr ""
"{count, plural, one {# vnos} two {# vnosa} few {# vnosi} other {# vnosov}}"
